# --- Atlassian OAuth 2.0 (3LO) app ---------------------------------------
# Create at https://developer.atlassian.com/console/myapps/
#   Permissions -> Jira API -> add the scopes listed in JIRA_SCOPES
#   Authorization -> OAuth 2.0 (3LO) -> Callback URL = APP_BASE_URL + /oauth/callback
ATLASSIAN_CLIENT_ID=your-client-id
ATLASSIAN_CLIENT_SECRET=your-client-secret

# Public base URL of this service (must be HTTPS for Jira to deliver webhooks).
# In development, use a tunnel such as `ngrok http 8000`.
APP_BASE_URL=https://your-subdomain.ngrok-free.app

# Space-separated OAuth scopes (classic scopes)
JIRA_SCOPES=read:jira-work write:jira-work read:jira-user manage:jira-webhook offline_access

# --- Security --------------------------------------------------------------
# Signs the browser session cookie. Any long random string.
SESSION_SECRET=change-me-to-a-long-random-string
# Encrypts OAuth tokens at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# --- Storage ---------------------------------------------------------------
# Empty = local SQLite file. On Vercel, set this to a Postgres URL (e.g. Neon);
# postgres:// and postgresql:// URLs are accepted as-is. Without it, Vercel falls back
# to SQLite in /tmp, which is wiped on every cold start (users must reconnect).
DATABASE_URL=

# --- Vercel ----------------------------------------------------------------
# Any long random string; Vercel Cron sends it to /cron/refresh-webhooks.
CRON_SECRET=
